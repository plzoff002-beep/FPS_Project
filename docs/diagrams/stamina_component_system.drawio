        </mxCell>
        <mxCell id="exp" value="&lt;h3&gt;UStaminaComponent - Explanation&lt;/h3&gt;&lt;p&gt;&lt;strong&gt;&lt;code&gt;Role&lt;/code&gt;&lt;/strong&gt;: A small, passive value holder. It has no tick; whoever spends the stamina calls it.&lt;/p&gt;&lt;p&gt;&lt;strong&gt;&lt;code&gt;OnStaminaChanged&lt;/code&gt;&lt;/strong&gt;: Broadcast only when the value actually changed, so the HUD is not updated every frame at full stamina.&lt;/p&gt;&lt;p&gt;&lt;strong&gt;&lt;code&gt;GetPercentage()&lt;/code&gt;&lt;/strong&gt;: Normalized 0..1 value for progress bars.&lt;/p&gt;" style="html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=10;fillColor=#fffdf2;strokeColor=#d6b656;rounded=1;" vertex="1" parent="1">
          <mxGeometry x="530" y="40" width="620" height="220" as="geometry"/>
