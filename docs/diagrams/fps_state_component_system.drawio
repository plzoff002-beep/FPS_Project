<mxfile host="app.diagrams.net">
  <diagram name="UFPSStateComponent - contents" id="sys_fps_state_component">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="cls" value="UFPSStateComponent" style="swimlane;fontStyle=1;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=26;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;html=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="40" width="640" height="305" as="geometry"/>
        </mxCell>
        <mxCell id="cls_f" value="- StateList: FStateList  (MovementState, WeaponState, StanceState, bAimed, bFalling, bCloseToWall)&lt;br&gt;+ OnStatesChanged: FOnStatesChanged" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;whiteSpace=wrap;html=1;" vertex="1" parent="cls">
          <mxGeometry y="26" width="640" height="59" as="geometry"/>
        </mxCell>
        <mxCell id="cls_l" value="" style="line;strokeWidth=1;fillColor=none;align=left;verticalAlign=middle;spacingTop=-1;spacingLeft=3;spacingRight=3;rotatable=0;labelPosition=right;points=[];portConstraint=eastwest;strokeColor=inherit;" vertex="1" parent="cls">
          <mxGeometry y="85" width="640" height="8" as="geometry"/>
        </mxCell>
        <mxCell id="cls_m" value="+ TrySetStanceState(NewState): bool&lt;br&gt;+ TrySetMovementState(NewState): bool&lt;br&gt;+ TrySetWeaponState(NewState): bool&lt;br&gt;+ TryToggleAimed(): bool&lt;br&gt;+ TrySetFalling(bFalling): bool&lt;br&gt;+ TrySetCloseToWall(bClose): bool&lt;br&gt;+ CanReload(): bool&lt;br&gt;+ IsBusy(): bool&lt;br&gt;+ IsStanding(): bool&lt;br&gt;+ IsAiming(): bool&lt;br&gt;+ IsSprinting(): bool&lt;br&gt;+ GetStateList(): FStateList" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;whiteSpace=wrap;html=1;" vertex="1" parent="cls">
          <mxGeometry y="93" width="640" height="212" as="geometry"/>
        </mxCell>
        <mxCell id="exp" value="&lt;h3&gt;UFPSStateComponent - Explanation&lt;/h3&gt;&lt;p&gt;&lt;strong&gt;&lt;code&gt;Role&lt;/code&gt;&lt;/strong&gt;: The single source of truth for what the character is doing. Other components read it and react instead of keeping their own copies of the flags.&lt;/p&gt;&lt;p&gt;&lt;strong&gt;&lt;code&gt;TrySet*()&lt;/code&gt;&lt;/strong&gt;: A request, not a command. It returns &lt;code&gt;false&lt;/code&gt; when nothing changes or the transition is not allowed (for example, sprinting is rejected while crouching or while the weapon is not Ready), and broadcasts &lt;code&gt;OnStatesChanged&lt;/code&gt; only on a real change.&lt;/p&gt;&lt;p&gt;&lt;strong&gt;&lt;code&gt;OnStatesChanged&lt;/code&gt;&lt;/strong&gt;: Multicast delegate carrying the whole &lt;code&gt;FStateList&lt;/code&gt;. FieldOfViewComponent subscribes to it; the AnimInstance reads the list through &lt;code&gt;GetStateList()&lt;/code&gt;.&lt;/p&gt;&lt;p&gt;&lt;strong&gt;&lt;code&gt;CanReload() / IsBusy()&lt;/code&gt;&lt;/strong&gt;: Query helpers that keep rule logic in one place (WeaponManager and SprintComponent do not duplicate it).&lt;/p&gt;" style="html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=10;fillColor=#fffdf2;strokeColor=#d6b656;rounded=1;" vertex="1" parent="1">
          <mxGeometry x="770" y="40" width="620" height="305" as="geometry"/>
        </mxCell>
        <mxCell id="arrow" value="" style="endArrow=classic;dashed=1;html=1;rounded=0;strokeColor=#999999;" edge="1" parent="1" source="cls" target="exp">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
