        <mxCell id="cls_m" value="+ Interact_Implementation(Interactor): void&lt;br&gt;+ GetPrimitiveOnInteract(): UPrimitiveComponent&lt;br&gt;+ GetExaminationItem(): FExamineItem*&lt;br&gt;+ Initialize(): void&lt;br&gt;+ SetItemDef(NewDef): void&lt;br&gt;+ SetAmount(NewAmount): void&lt;br&gt;+ ThrowItem(Direction): void" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;whiteSpace=wrap;html=1;" vertex="1" parent="cls">
          <mxGeometry y="93" width="400" height="127" as="geometry"/>
        </mxCell>
        <mxCell id="exp" value="&lt;h3&gt;APickUpActor - Explanation&lt;/h3&gt;&lt;p&gt;&lt;strong&gt;&lt;code&gt;Role&lt;/code&gt;&lt;/strong&gt;: A world item. It implements &lt;code&gt;IInteractableInterface&lt;/code&gt; and &lt;code&gt;IExaminatableInterface&lt;/code&gt;, so the interaction component works with any item through interfaces.&lt;/p&gt;&lt;p&gt;&lt;strong&gt;&lt;code&gt;ThrowItem()&lt;/code&gt;&lt;/strong&gt;: Applies an impulse; used when an item is dropped from the inventory.&lt;/p&gt;&lt;p&gt;&lt;strong&gt;&lt;code&gt;SpawnActorDeferred&lt;/code&gt;&lt;/strong&gt;: The character spawns it deferred, sets the definition and amount, then finishes spawning, so construction scripts see valid data.&lt;/p&gt;" style="html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=10;fillColor=#fffdf2;strokeColor=#d6b656;rounded=1;" vertex="1" parent="1">
          <mxGeometry x="530" y="40" width="620" height="220" as="geometry"/>
