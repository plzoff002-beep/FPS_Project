        <mxCell id="exp" value="&lt;h3&gt;AExamineStudio - Explanation&lt;/h3&gt;&lt;p&gt;&lt;strong&gt;&lt;code&gt;Role&lt;/code&gt;&lt;/strong&gt;: A tiny scene that owns the examination camera and an anchor for the examined item.&lt;/p&gt;&lt;p&gt;&lt;strong&gt;&lt;code&gt;Rotation&lt;/code&gt;&lt;/strong&gt;: Applied to &lt;code&gt;ItemAnchor&lt;/code&gt;, not to the item, so the item keeps its own pivot.&lt;/p&gt;&lt;p&gt;&lt;strong&gt;&lt;code&gt;LoadItemClassAsync()&lt;/code&gt;&lt;/strong&gt;: The item class is soft; &lt;code&gt;CurrentClassToLoad&lt;/code&gt; and &lt;code&gt;bActive&lt;/code&gt; discard late results after the examination has ended.&lt;/p&gt;&lt;p&gt;&lt;strong&gt;&lt;code&gt;AdjustSceneCamera()&lt;/code&gt;&lt;/strong&gt;: Zooms inside distance limits defined by the item data.&lt;/p&gt;" style="html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=10;fillColor=#fffdf2;strokeColor=#d6b656;rounded=1;" vertex="1" parent="1">
          <mxGeometry x="530" y="40" width="620" height="339" as="geometry"/>
