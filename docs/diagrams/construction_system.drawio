        <mxCell id="SfDgYsewkCgwbqOTThhK-2" parent="SfDgYsewkCgwbqOTThhK-1" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=wrap;html=1;" value="&lt;div&gt;- bCanPlace: bool&lt;/div&gt;&lt;div&gt;- bBuildModeActive: bool&lt;/div&gt;&lt;div&gt;- bGhostMeshReady: bool&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;- MaxBuildDistance: float&lt;/div&gt;&lt;div&gt;- RotateRate: float&lt;/div&gt;&lt;div&gt;- GroundDigDepth: float&lt;/div&gt;&lt;div&gt;- MaxFloatingDistance: float&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;- CurrentIndexToLoad: int32&lt;/div&gt;&lt;div&gt;- LastSnappedLocation: FVector&lt;/div&gt;&lt;div&gt;- FinalSnappedLocation: FVector&lt;/div&gt;&lt;div&gt;- RotateTarget: FRotator&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;- PlayerCamera: TWeakObjectPtr&amp;lt;USceneComponent&amp;gt;&lt;/div&gt;&lt;div&gt;- GhostActor: TObjectPtr&amp;lt;AStaticMeshActor&amp;gt;&lt;/div&gt;&lt;div&gt;- GhostDMI: TWeakObjectPtr&amp;lt;UMaterialInstanceDynamic&amp;gt;&lt;/div&gt;&lt;div&gt;- HologramBaseMaterial: TObjectPtr&amp;lt;UMaterialInterface&amp;gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;- BuildLibrary: TWeakObjectPtr&amp;lt;UBuildLibraryData&amp;gt;&lt;/div&gt;&lt;div&gt;- CurrentBuildData: TObjectPtr&amp;lt;UBuildObjectData&amp;gt;&lt;/div&gt;&lt;div&gt;- PreviousBuildData: TWeakObjectPtr&amp;lt;UBuildObjectData&amp;gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="324" width="560" y="26" as="geometry" />
        </mxCell>
        <mxCell id="SfDgYsewkCgwbqOTThhK-3" parent="SfDgYsewkCgwbqOTThhK-1" style="line;strokeWidth=1;fillColor=none;align=left;verticalAlign=middle;spacingTop=-1;spacingLeft=3;spacingRight=3;rotatable=0;labelPosition=right;points=[];portConstraint=eastwest;strokeColor=inherit;" value="" vertex="1">
          <mxGeometry height="8" width="560" y="350" as="geometry" />
