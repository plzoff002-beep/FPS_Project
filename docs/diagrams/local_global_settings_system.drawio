        <mxCell id="cls_m" value="+ SetSystemData(NewData): void&lt;br&gt;+ SetAndApplyGameplaySettings(Mutator): void&lt;br&gt;+ SetAndApplyAudioSettings(Mutator): void&lt;br&gt;+ SetAndApplyGraphicsSettings(Mutator): void&lt;br&gt;+ SaveAllSettings(): void&lt;br&gt;+ LoadAndApplyAllSettings(): void&lt;br&gt;+ ApplyGlobalEngineSettings(): void" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;whiteSpace=wrap;html=1;" vertex="1" parent="cls">
          <mxGeometry y="110" width="400" height="127" as="geometry"/>
        </mxCell>
        <mxCell id="exp" value="&lt;h3&gt;ULocalGlobalSettings - Explanation&lt;/h3&gt;&lt;p&gt;&lt;strong&gt;&lt;code&gt;Role&lt;/code&gt;&lt;/strong&gt;: LocalPlayer subsystem that stores player settings and tells listeners about changes.&lt;/p&gt;&lt;p&gt;&lt;strong&gt;&lt;code&gt;OnGameplaySettingsChanged&lt;/code&gt;&lt;/strong&gt;: The character subscribes and copies the values (&lt;code&gt;SetPlayerGameplayConfig&lt;/code&gt;), so no gameplay class reads the settings widget.&lt;/p&gt;&lt;p&gt;&lt;strong&gt;&lt;code&gt;SaveAllSettings() / LoadAndApplyAllSettings()&lt;/code&gt;&lt;/strong&gt;: Persist settings with &lt;code&gt;UFPSGlobalSettingsSave&lt;/code&gt; (SaveGame). Known to be unstable, see README.&lt;/p&gt;&lt;p&gt;&lt;strong&gt;&lt;code&gt;SetAndApply*Settings()&lt;/code&gt;&lt;/strong&gt;: Take a mutator lambda (&lt;code&gt;TFunctionRef&lt;/code&gt;), so a widget changes only the field it owns and the subsystem applies and broadcasts it.&lt;/p&gt;" style="html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=10;fillColor=#fffdf2;strokeColor=#d6b656;rounded=1;" vertex="1" parent="1">
          <mxGeometry x="530" y="40" width="620" height="237" as="geometry"/>
        </mxCell>
        <mxCell id="arrow" value="" style="endArrow=classic;dashed=1;html=1;rounded=0;strokeColor=#999999;" edge="1" parent="1" source="cls" target="exp">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
