<mxfile host="app.diagrams.net">
  <diagram name="UInventoryComponent - contents" id="sys_inventory_component">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="cls" value="UInventoryComponent" style="swimlane;fontStyle=1;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=26;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;html=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="40" width="598" height="305" as="geometry"/>
        </mxCell>
        <mxCell id="cls_f" value="- InventorySize: int32&lt;br&gt;- Slots: TArray&amp;lt;FInventorySlot&amp;gt;  (ItemDef, Quantity, ItemType, ActionMap, SpawnedActor)&lt;br&gt;+ OnItemAdded: FOnItemAdded&lt;br&gt;+ OnInventoryChanged: FOnInventoryChanged&lt;br&gt;+ OnInventorySlotSelected&lt;br&gt;+ OnInventorySlotDropped&lt;br&gt;+ OnInventorySlotCleared" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;whiteSpace=wrap;html=1;" vertex="1" parent="cls">
          <mxGeometry y="26" width="598" height="127" as="geometry"/>
        </mxCell>
        <mxCell id="cls_l" value="" style="line;strokeWidth=1;fillColor=none;align=left;verticalAlign=middle;spacingTop=-1;spacingLeft=3;spacingRight=3;rotatable=0;labelPosition=right;points=[];portConstraint=eastwest;strokeColor=inherit;" vertex="1" parent="cls">
          <mxGeometry y="153" width="598" height="8" as="geometry"/>
        </mxCell>
        <mxCell id="cls_m" value="+ AddItem(Item, Amount): bool&lt;br&gt;+ RemoveItem(SlotIndex): void&lt;br&gt;+ DropItem(SlotIndex): void&lt;br&gt;+ SelectItem(Index): void&lt;br&gt;+ RegisterActorInSlot(LoadedData): void&lt;br&gt;+ GetSlot(SlotIndex): FInventorySlot*&lt;br&gt;+ FindSlotsWithFragment&amp;lt;T&amp;gt;(): TArray&amp;lt;int32&amp;gt;&lt;br&gt;- ClearSlot(Slot): void" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;whiteSpace=wrap;html=1;" vertex="1" parent="cls">
          <mxGeometry y="161" width="598" height="144" as="geometry"/>
        </mxCell>
        <mxCell id="exp" value="&lt;h3&gt;UInventoryComponent - Explanation&lt;/h3&gt;&lt;p&gt;&lt;strong&gt;&lt;code&gt;Role&lt;/code&gt;&lt;/strong&gt;: Data model of the inventory. It stores slots and announces changes; it knows nothing about widgets or weapons.&lt;/p&gt;&lt;p&gt;&lt;strong&gt;&lt;code&gt;AddItem()&lt;/code&gt;&lt;/strong&gt;: Stacks into existing slots first, then takes an empty slot. A new slot raises &lt;code&gt;OnItemAdded&lt;/code&gt; so the owner can spawn the item's actor.&lt;/p&gt;&lt;p&gt;&lt;strong&gt;&lt;code&gt;RegisterActorInSlot()&lt;/code&gt;&lt;/strong&gt;: Receives the async-loaded actor from the WeaponManager (&lt;code&gt;FLoadedItemData&lt;/code&gt;) and stores it in the slot.&lt;/p&gt;&lt;p&gt;&lt;strong&gt;&lt;code&gt;ClearSlot()&lt;/code&gt;&lt;/strong&gt;: Raises &lt;code&gt;OnInventorySlotCleared&lt;/code&gt; before destroying the spawned actor so listeners can unequip it.&lt;/p&gt;&lt;p&gt;&lt;strong&gt;&lt;code&gt;Fragments&lt;/code&gt;&lt;/strong&gt;: Item behaviour comes from &lt;code&gt;UItemFragment&lt;/code&gt; objects in the definition (for example the weapon fragment). &lt;code&gt;FindSlotsWithFragment&amp;lt;T&amp;gt;()&lt;/code&gt; searches by capability, not by item type.&lt;/p&gt;" style="html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=10;fillColor=#fffdf2;strokeColor=#d6b656;rounded=1;" vertex="1" parent="1">
          <mxGeometry x="728" y="40" width="620" height="311" as="geometry"/>
        </mxCell>
        <mxCell id="arrow" value="" style="endArrow=classic;dashed=1;html=1;rounded=0;strokeColor=#999999;" edge="1" parent="1" source="cls" target="exp">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
