        <mxCell id="cls_m" value="+ SetupStudio(): void&lt;br&gt;+ StartExamination(Data: FExamineItem*): void&lt;br&gt;+ StopExamination(): void&lt;br&gt;+ RotateItem(Delta): void&lt;br&gt;+ AdjustSceneCamera(Direction): void&lt;br&gt;- LoadStudioClassAsync(): void&lt;br&gt;- SetupStudioOnLoaded(): void" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;whiteSpace=wrap;html=1;" vertex="1" parent="cls">
          <mxGeometry y="59" width="400" height="127" as="geometry"/>
        </mxCell>
        <mxCell id="exp" value="&lt;h3&gt;UExaminationComponent - Explanation&lt;/h3&gt;&lt;p&gt;&lt;strong&gt;&lt;code&gt;Role&lt;/code&gt;&lt;/strong&gt;: Controls the examination flow: remember the current view target, blend to the studio, lock look/move input, push the widget. Stopping reverses everything.&lt;/p&gt;&lt;p&gt;&lt;strong&gt;&lt;code&gt;SetupStudio()&lt;/code&gt;&lt;/strong&gt;: The studio class is a soft reference loaded asynchronously; the studio is spawned far from the level so it never overlaps level geometry.&lt;/p&gt;&lt;p&gt;&lt;strong&gt;&lt;code&gt;StartExamination()&lt;/code&gt;&lt;/strong&gt;: Passes the item data to the studio and blends the camera.&lt;/p&gt;&lt;p&gt;&lt;strong&gt;&lt;code&gt;RotateItem() / AdjustSceneCamera()&lt;/code&gt;&lt;/strong&gt;: Forwarded to the studio, which owns the camera and the item anchor.&lt;/p&gt;" style="html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=10;fillColor=#fffdf2;strokeColor=#d6b656;rounded=1;" vertex="1" parent="1">
          <mxGeometry x="530" y="40" width="620" height="227" as="geometry"/>
        </mxCell>
        <mxCell id="arrow" value="" style="endArrow=classic;dashed=1;html=1;rounded=0;strokeColor=#999999;" edge="1" parent="1" source="cls" target="exp">
