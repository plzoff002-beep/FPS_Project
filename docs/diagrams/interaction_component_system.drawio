<mxfile host="app.diagrams.net">
  <diagram name="UInteractionComponent - contents" id="sys_interaction_component">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="cls" value="UInteractionComponent" style="swimlane;fontStyle=1;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=26;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;html=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="40" width="400" height="169" as="geometry"/>
        </mxCell>
        <mxCell id="cls_f" value="- InteractionMaxDistance: float  (250)&lt;br&gt;- OwnerActor: AActor" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;whiteSpace=wrap;html=1;" vertex="1" parent="cls">
          <mxGeometry y="26" width="400" height="42" as="geometry"/>
        </mxCell>
        <mxCell id="cls_l" value="" style="line;strokeWidth=1;fillColor=none;align=left;verticalAlign=middle;spacingTop=-1;spacingLeft=3;spacingRight=3;rotatable=0;labelPosition=right;points=[];portConstraint=eastwest;strokeColor=inherit;" vertex="1" parent="cls">
          <mxGeometry y="68" width="400" height="8" as="geometry"/>
        </mxCell>
        <mxCell id="cls_m" value="+ EndInteraction(ElapsedTime): void&lt;br&gt;+ TryGrabObject(): void&lt;br&gt;+ TryPickUpObject(): void&lt;br&gt;+ TryExamineItem(bExamined: bool&amp;amp;): void&lt;br&gt;- PerformInteractionTrace(OutHit): bool" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;whiteSpace=wrap;html=1;" vertex="1" parent="cls">
          <mxGeometry y="76" width="400" height="93" as="geometry"/>
        </mxCell>
        <mxCell id="exp" value="&lt;h3&gt;UInteractionComponent - Explanation&lt;/h3&gt;&lt;p&gt;&lt;strong&gt;&lt;code&gt;Role&lt;/code&gt;&lt;/strong&gt;: Finds the object in front of the player and decides what 'interact' means for it.&lt;/p&gt;&lt;p&gt;&lt;strong&gt;&lt;code&gt;EndInteraction()&lt;/code&gt;&lt;/strong&gt;: Called when the key is released. A tap shorter than 0.2 s releases anything held and tries to pick up; a longer hold grabs a physics object.&lt;/p&gt;&lt;p&gt;&lt;strong&gt;&lt;code&gt;PerformInteractionTrace()&lt;/code&gt;&lt;/strong&gt;: Line trace from &lt;code&gt;GetActorEyesViewPoint()&lt;/code&gt;, so the origin and direction match the camera.&lt;/p&gt;&lt;p&gt;&lt;strong&gt;&lt;code&gt;TryPickUpObject()&lt;/code&gt;&lt;/strong&gt;: Works through &lt;code&gt;IInteractableInterface&lt;/code&gt;; the component does not know concrete actor classes.&lt;/p&gt;&lt;p&gt;&lt;strong&gt;&lt;code&gt;TryExamineItem()&lt;/code&gt;&lt;/strong&gt;: Works through &lt;code&gt;IExaminatableInterface&lt;/code&gt; and starts the examination component.&lt;/p&gt;" style="html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=10;fillColor=#fffdf2;strokeColor=#d6b656;rounded=1;" vertex="1" parent="1">
          <mxGeometry x="530" y="40" width="620" height="260" as="geometry"/>
        </mxCell>
        <mxCell id="arrow" value="" style="endArrow=classic;dashed=1;html=1;rounded=0;strokeColor=#999999;" edge="1" parent="1" source="cls" target="exp">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
