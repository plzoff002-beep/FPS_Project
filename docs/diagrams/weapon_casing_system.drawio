        </mxCell>
        <mxCell id="exp" value="&lt;h3&gt;AWeapon_Casing - Explanation&lt;/h3&gt;&lt;p&gt;&lt;strong&gt;&lt;code&gt;Role&lt;/code&gt;&lt;/strong&gt;: A pooled shell casing. It is never destroyed during gameplay.&lt;/p&gt;&lt;p&gt;&lt;strong&gt;&lt;code&gt;ActivateCasing()&lt;/code&gt;&lt;/strong&gt;: Enables collision and visibility, activates the projectile movement and enables the tick.&lt;/p&gt;&lt;p&gt;&lt;strong&gt;&lt;code&gt;DisableCasing()&lt;/code&gt;&lt;/strong&gt;: Returns the casing to the pool: collision off, hidden, movement deactivated, tick off, timers reset.&lt;/p&gt;&lt;p&gt;&lt;strong&gt;&lt;code&gt;Tick()&lt;/code&gt;&lt;/strong&gt;: Counts the lifetime and calls &lt;code&gt;DisableCasing()&lt;/code&gt; when &lt;code&gt;MaxLifeTime&lt;/code&gt; is exceeded.&lt;/p&gt;" style="html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=10;fillColor=#fffdf2;strokeColor=#d6b656;rounded=1;" vertex="1" parent="1">
          <mxGeometry x="530" y="40" width="620" height="237" as="geometry"/>
        </mxCell>
