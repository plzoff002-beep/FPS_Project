        <mxCell id="exp" value="&lt;h3&gt;UHandleGrabComponent - Explanation&lt;/h3&gt;&lt;p&gt;&lt;strong&gt;&lt;code&gt;Role&lt;/code&gt;&lt;/strong&gt;: Carries physics objects using a Physics Handle.&lt;/p&gt;&lt;p&gt;&lt;strong&gt;&lt;code&gt;TickComponent()&lt;/code&gt;&lt;/strong&gt;: Each tick moves the handle target to &lt;code&gt;ViewPoint forward * MaxGrabDistance&lt;/code&gt;, so the object follows the crosshair.&lt;/p&gt;&lt;p&gt;&lt;strong&gt;&lt;code&gt;ThrowObject()&lt;/code&gt;&lt;/strong&gt;: Releases the object and applies an impulse in the view direction.&lt;/p&gt;" style="html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=10;fillColor=#fffdf2;strokeColor=#d6b656;rounded=1;" vertex="1" parent="1">
