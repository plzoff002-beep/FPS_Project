<mxfile host="app.diagrams.net">
  <diagram name="USprintComponent - contents" id="sys_sprint_component">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="cls" value="USprintComponent" style="swimlane;fontStyle=1;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=26;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;html=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="40" width="400" height="271" as="geometry"/>
        </mxCell>
        <mxCell id="cls_f" value="- WalkSpeed: float&lt;br&gt;- SprintSpeed: float&lt;br&gt;- SpeedAccel: float&lt;br&gt;- bWantToSprint: bool&lt;br&gt;- bSprinting: bool&lt;br&gt;- StaminaComp: UStaminaComponent&lt;br&gt;- StateComp: UFPSStateComponent" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;whiteSpace=wrap;html=1;" vertex="1" parent="cls">
          <mxGeometry y="26" width="400" height="127" as="geometry"/>
        </mxCell>
        <mxCell id="cls_l" value="" style="line;strokeWidth=1;fillColor=none;align=left;verticalAlign=middle;spacingTop=-1;spacingLeft=3;spacingRight=3;rotatable=0;labelPosition=right;points=[];portConstraint=eastwest;strokeColor=inherit;" vertex="1" parent="cls">
          <mxGeometry y="153" width="400" height="8" as="geometry"/>
        </mxCell>
        <mxCell id="cls_m" value="+ ToggleSprint(): void&lt;br&gt;+ IsSprinting(): bool&lt;br&gt;+ SetStaminaComponent(NewComp): void&lt;br&gt;+ InitFromDataAsset(Data): void&lt;br&gt;- ApplyMovementState(NewState): void&lt;br&gt;+ TickComponent(): void" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;whiteSpace=wrap;html=1;" vertex="1" parent="cls">
          <mxGeometry y="161" width="400" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="exp" value="&lt;h3&gt;USprintComponent - Explanation&lt;/h3&gt;&lt;p&gt;&lt;strong&gt;&lt;code&gt;Role&lt;/code&gt;&lt;/strong&gt;: Turns the sprint intent into a walk speed and stamina cost.&lt;/p&gt;&lt;p&gt;&lt;strong&gt;&lt;code&gt;ToggleSprint()&lt;/code&gt;&lt;/strong&gt;: Only stores the intent (&lt;code&gt;bWantToSprint&lt;/code&gt;). The actual decision is made in the tick.&lt;/p&gt;&lt;p&gt;&lt;strong&gt;&lt;code&gt;Sprint condition&lt;/code&gt;&lt;/strong&gt;: Sprint is active if the player wants it, stamina is above zero, the state component says the character is not busy and is standing.&lt;/p&gt;&lt;p&gt;&lt;strong&gt;&lt;code&gt;TickComponent()&lt;/code&gt;&lt;/strong&gt;: Interpolates &lt;code&gt;MaxWalkSpeed&lt;/code&gt; with &lt;code&gt;FInterpTo&lt;/code&gt;, drains stamina while actually moving fast and regenerates it otherwise.&lt;/p&gt;&lt;p&gt;&lt;strong&gt;&lt;code&gt;InitFromDataAsset()&lt;/code&gt;&lt;/strong&gt;: Speeds come from &lt;code&gt;UCharacterStatsDataAsset&lt;/code&gt;, not from hard-coded values.&lt;/p&gt;" style="html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=10;fillColor=#fffdf2;strokeColor=#d6b656;rounded=1;" vertex="1" parent="1">
          <mxGeometry x="530" y="40" width="620" height="271" as="geometry"/>
        </mxCell>
        <mxCell id="arrow" value="" style="endArrow=classic;dashed=1;html=1;rounded=0;strokeColor=#999999;" edge="1" parent="1" source="cls" target="exp">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
