<mxfile host="app.diagrams.net">
  <diagram name="AFPSCharacter - contents" id="sys_fps_character">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="cls" value="AFPSCharacter" style="swimlane;fontStyle=1;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=26;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;html=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="40" width="413" height="645" as="geometry"/>
        </mxCell>
        <mxCell id="cls_f" value="- Pivot: USceneComponent&lt;br&gt;- Camera: UCameraComponent&lt;br&gt;- CharacterArms: USkeletalMeshComponent&lt;br&gt;- WeaponManager: UWeaponManager&lt;br&gt;- Inventory: UInventoryComponent&lt;br&gt;- StateComponent: UFPSStateComponent&lt;br&gt;- RecoilComponent: URecoilComponent&lt;br&gt;- FOVComp: UFieldOfViewComponent&lt;br&gt;- ViewModel: UViewModelComponent&lt;br&gt;- SprintComponent: USprintComponent&lt;br&gt;- StaminaComponent: UStaminaComponent&lt;br&gt;- CrouchComponent: UCrouchComponent&lt;br&gt;- InteractionComponent: UInteractionComponent&lt;br&gt;- HandleGrabComponent: UHandleGrabComponent&lt;br&gt;- ConstructionComponent: UConstructionComponent&lt;br&gt;- ExaminationComponent: UExaminationComponent&lt;br&gt;- UIData: UUIData&lt;br&gt;- SystemData: USystemData" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;whiteSpace=wrap;html=1;" vertex="1" parent="cls">
          <mxGeometry y="26" width="413" height="314" as="geometry"/>
        </mxCell>
        <mxCell id="cls_l" value="" style="line;strokeWidth=1;fillColor=none;align=left;verticalAlign=middle;spacingTop=-1;spacingLeft=3;spacingRight=3;rotatable=0;labelPosition=right;points=[];portConstraint=eastwest;strokeColor=inherit;" vertex="1" parent="cls">
          <mxGeometry y="340" width="413" height="8" as="geometry"/>
        </mxCell>
        <mxCell id="cls_m" value="+ GetActorEyesViewPoint(OutLocation, OutRotation): void&lt;br&gt;+ OnMovementModeChanged(Prev, PrevCustom): void&lt;br&gt;+ MoveCharacter(Axis: FVector2D): void&lt;br&gt;+ Look(Axis: FVector2D): void&lt;br&gt;+ GetViewModelState(): FViewModelState&lt;br&gt;+ GetWeaponIKData(): FWeaponIKData&lt;br&gt;+ GetRightHandIKTransform(): FTransform&lt;br&gt;+ SetPlayerGameplayConfig(NewData): void&lt;br&gt;+ SetCameraRelativeLocation(NewLocation): void&lt;br&gt;+ UpdateIsCloseToWall(): void&lt;br&gt;# BeginPlay(): void&lt;br&gt;# ItemSpawnerHandler(ItemDef, SlotIndex): void&lt;br&gt;# ItemSelectionHandler(Index, SpawnedActor, ItemType): void&lt;br&gt;- HandleSlotCleared(SlotIndex): void&lt;br&gt;- SetDropLocation(ItemToDrop): void&lt;br&gt;- UnifiedUIHandler(ButtonType, Context): void&lt;br&gt;- UpdateMovementState(): void" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;whiteSpace=wrap;html=1;" vertex="1" parent="cls">
          <mxGeometry y="348" width="413" height="297" as="geometry"/>
        </mxCell>
        <mxCell id="exp" value="&lt;h3&gt;AFPSCharacter - Explanation&lt;/h3&gt;&lt;p&gt;&lt;strong&gt;&lt;code&gt;Role&lt;/code&gt;&lt;/strong&gt;: The character is the composition root. It creates every gameplay component in the constructor and contains almost no gameplay logic itself: it wires the components together in &lt;code&gt;BeginPlay()&lt;/code&gt; through delegates.&lt;/p&gt;&lt;p&gt;&lt;strong&gt;&lt;code&gt;GetActorEyesViewPoint()&lt;/code&gt;&lt;/strong&gt;: Overridden so every system that asks the pawn where it looks (interaction trace, grabbing) gets the camera's location and direction instead of the capsule's.&lt;/p&gt;&lt;p&gt;&lt;strong&gt;&lt;code&gt;BeginPlay()&lt;/code&gt;&lt;/strong&gt;: The wiring hub: WeaponManager.OnWeaponChanged -&gt; ViewModel, ViewModel.OnMontageFinished -&gt; WeaponManager, Inventory.OnItemAdded -&gt; ItemSpawnerHandler, WeaponManager.OnWeaponLoaded -&gt; Inventory.RegisterActorInSlot, WeaponManager.OnShoot -&gt; RecoilComponent, StateComponent.OnStatesChanged -&gt; FOVComp.&lt;/p&gt;&lt;p&gt;&lt;strong&gt;&lt;code&gt;ItemSpawnerHandler()&lt;/code&gt;&lt;/strong&gt;: Reacts to a new inventory item. Looks for a weapon fragment in the item definition and asks the WeaponManager to load the weapon class asynchronously.&lt;/p&gt;&lt;p&gt;&lt;strong&gt;&lt;code&gt;ItemSelectionHandler()&lt;/code&gt;&lt;/strong&gt;: Reacts to a selected slot. Routes by &lt;code&gt;EItemType&lt;/code&gt;; weapons go to &lt;code&gt;WeaponManager-&gt;SwapWeapon()&lt;/code&gt;.&lt;/p&gt;&lt;p&gt;&lt;strong&gt;&lt;code&gt;HandleSlotCleared()&lt;/code&gt;&lt;/strong&gt;: If the cleared slot is the equipped one, the weapon is unequipped immediately.&lt;/p&gt;&lt;p&gt;&lt;strong&gt;&lt;code&gt;GetWeaponIKData() / GetRightHandIKTransform()&lt;/code&gt;&lt;/strong&gt;: Implementation of &lt;code&gt;IWeaponIKProvider&lt;/code&gt;. The AnimInstance reads IK data through the interface, so it never depends on the character class.&lt;/p&gt;&lt;p&gt;&lt;strong&gt;&lt;code&gt;GetViewModelState()&lt;/code&gt;&lt;/strong&gt;: Implementation of &lt;code&gt;ICharacterStateProvider&lt;/code&gt;: hands the spring values (sway, jump, movement) from the ViewModel to the animation graph.&lt;/p&gt;&lt;p&gt;&lt;strong&gt;&lt;code&gt;UpdateMovementState()&lt;/code&gt;&lt;/strong&gt;: Called every tick; classifies speed into Idle / Walking / Sprinting and reports it to the state component.&lt;/p&gt;&lt;p&gt;&lt;strong&gt;&lt;code&gt;UpdateIsCloseToWall()&lt;/code&gt;&lt;/strong&gt;: Forward line trace; the result is stored as a state flag so weapons can be lowered near walls.&lt;/p&gt;" style="html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=10;fillColor=#fffdf2;strokeColor=#d6b656;rounded=1;" vertex="1" parent="1">
          <mxGeometry x="543" y="40" width="620" height="645" as="geometry"/>
        </mxCell>
        <mxCell id="arrow" value="" style="endArrow=classic;dashed=1;html=1;rounded=0;strokeColor=#999999;" edge="1" parent="1" source="cls" target="exp">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
